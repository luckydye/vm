#!/bin/sh
# Fetch the branches of a git repo in a VM into the current repo as <vm>/<branch>
# usage: vm pull VM [GUEST_PATH]
# GUEST_PATH defaults to work, where `vm run --seed .:work` puts the repo.
set -e
[ -n "$1" ] || { echo "usage: vm pull VM [GUEST_PATH]" >&2; exit 2; }
exec git -c protocol.ext.allow=always fetch "ext::$VM run $1 -- %S ${2:-work}" "+refs/heads/*:refs/remotes/$1/*"
