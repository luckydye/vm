#!/bin/sh
# Writes the global instruction files of Claude Code, Codex and OpenCode from
# the user's guidelines and this VM's environment briefing.
#
# The guidelines live in ~/.config/varmint/AGENTS.md, which no agent reads on
# its own, so a seed carries that one file and every agent gets the same text.
set -eu

home=${1:-$HOME}
guidelines=$home/.config/varmint/AGENTS.md
briefing=/usr/local/share/varmint/AGENTS.md

for file in .claude/CLAUDE.md .codex/AGENTS.md .config/opencode/AGENTS.md; do
    target=$home/$file
    mkdir -p "$(dirname "$target")"

    if [ -f "$guidelines" ]; then
        cat "$guidelines" > "$target"
        printf '\n' >> "$target"
    else
        : > "$target"
    fi
    cat "$briefing" >> "$target"
done
